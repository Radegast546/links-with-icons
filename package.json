{
  "name": "links-with-icons",
  "version": "1.1.2",
  "description": "Show file, folder, and website icons next to links in your notes. On Windows, use the familiar application icons from File Explorer.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "deploy": "node esbuild.config.mjs production --deploy",
    "bump-version": "node scripts/bump-version.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "check": "npm run typecheck && npm run lint",
    "verify-version": "node scripts/verify-version.mjs"
  },
  "keywords": [
    "obsidian",
    "icons",
    "favicons"
  ],
  "author": "Radegast546",
  "license": "GPL-3.0-only",
  "overrides": {
    "minimatch@>=7 <11.0.1": "^11.0.1",
    "brace-expansion@^1.1.0": "^1.1.21"
  },
  "devDependencies": {
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/common": "^1.3.0",
    "@lezer/markdown": "^1.4.3",
    "@types/node": "^22.15.17",
    "@eslint/js": "^9.39.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "globals": "^17.6.0",
    "obsidian": "1.14.4",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.59.1"
  }
}
